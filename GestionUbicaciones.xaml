<Window x:Class="Inventario_Hardware_IT.GestionUbicaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Ubicaciones" Height="600" Width="900" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F5F7FA" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#B0B0B0" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10,10,0,0" MouseDown="Border_MouseDown" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="📍" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="GESTIÓN DE SEDES Y UBICACIONES" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCerrar_Click" HorizontalAlignment="Right" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" Foreground="#95A5A6" BorderThickness="0" FontSize="16" Cursor="Hand" Style="{x:Null}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="1. Registrar Sede (Edificio)" Foreground="#007ACC" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Nombre del Edificio / Sede:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtSede" Margin="0,0,0,10"/>
                            <Button Content="GUARDAR SEDE" Click="BtnGuardarSede_Click" Style="{StaticResource BtnAzul}" Height="35" Margin="0,0,0,20"/>
                        </StackPanel>
                        <DataGrid Grid.Row="2" x:Name="gridSedes" AutoGenerateColumns="True" IsReadOnly="True" Background="White"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="2. Registrar Ubicación (Sala/Oficina)" Foreground="#27AE60" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Pertenece a la Sede:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbSedes" Height="30" Margin="0,0,0,10" DisplayMemberPath="NombreSede" SelectedValuePath="SedeID"/>
                            <TextBlock Text="Nombre de la Oficina:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtUbicacion" Margin="0,0,0,10"/>
                            <Button Content="GUARDAR UBICACIÓN" Click="BtnGuardarUbicacion_Click" Height="35" Margin="0,0,0,20" Background="#27AE60" Foreground="White"/>
                        </StackPanel>
                        <DataGrid Grid.Row="2" x:Name="gridUbicaciones" AutoGenerateColumns="True" IsReadOnly="True" Background="White"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>