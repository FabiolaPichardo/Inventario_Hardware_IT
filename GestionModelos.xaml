<Window x:Class="Inventario_Hardware_IT.GestionModelos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Modelos" Height="500" Width="700" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Paso 3: Definir Modelos (Ej: Latitude 5420)" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0" Grid.Column="0">
                    <TextBlock Text="Selecciona Marca:"/>
                    <ComboBox x:Name="cbMarca" Height="25" 
                              DisplayMemberPath="NombreMarca" 
                              SelectedValuePath="MarcaID"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0" Grid.Column="1">
                    <TextBlock Text="Selecciona Tipo:"/>
                    <ComboBox x:Name="cbTipo" Height="25"
                              DisplayMemberPath="NombreTipo" 
                              SelectedValuePath="TipoID"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nombre del Modelo:"/>
                    <TextBox x:Name="txtModelo" Height="25" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Button x:Name="btnGuardar" Content="Guardar Modelo" Click="BtnGuardar_Click" 
                    Width="150" Height="30" Margin="0,15,0,0" HorizontalAlignment="Right" 
                    Background="#28a745" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="gridDatos" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F0F0F0"/>
    </Grid>
</Window>