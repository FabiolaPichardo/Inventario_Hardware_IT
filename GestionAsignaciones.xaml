<Window x:Class="Inventario_Hardware_IT.GestionAsignaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignación de Equipos" Height="600" Width="900" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F5F7FA" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#B0B0B0" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10,10,0,0" MouseDown="Border_MouseDown" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="ASIGNACIÓN DE EQUIPOS" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCerrar_Click" HorizontalAlignment="Right" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" Foreground="#95A5A6" BorderThickness="0" FontSize="16" Cursor="Hand" Style="{x:Null}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="20" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Nueva Asignación" Foreground="#27AE60" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Equipo Disponible:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbHardware"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Empleado:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbEmpleado" DisplayMemberPath="NombreCompleto" SelectedValuePath="EmpleadoID"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Fecha:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpFecha" Width="120"/>
                            </StackPanel>

                            <Button Content="ASIGNAR EQUIPO" Click="BtnAsignar_Click" Style="{StaticResource BtnVerde}" Width="140" Height="35" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="20,0,20,20" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                </Border.Effect>

                <DataGrid x:Name="gridAsignaciones" AutoGenerateColumns="True" IsReadOnly="True"
                          HeadersVisibility="Column" Background="White" RowBackground="White" AlternatingRowBackground="#F8F9F9"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#ECF0F1"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>