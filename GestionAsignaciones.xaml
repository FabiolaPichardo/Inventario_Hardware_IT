<Window x:Class="Inventario_Hardware_IT.GestionAsignaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignación de Equipos (Módulo 5 - Jaqueline)" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📋 Asignar Equipo a Empleado" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Header="Nueva Asignación" Margin="0,0,0,20" Padding="10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Equipo Disponible (Serie - Modelo):"/>
                    <ComboBox x:Name="cbHardware" Width="250" Height="25"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Empleado:"/>
                    <ComboBox x:Name="cbEmpleado" Width="200" Height="25" DisplayMemberPath="NombreCompleto" SelectedValuePath="EmpleadoID"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Fecha Asignación:"/>
                    <DatePicker x:Name="dpFecha" Width="120"/>
                </StackPanel>

                <Button Content="ASIGNAR" Click="BtnAsignar_Click" Width="100" Height="25" VerticalAlignment="Bottom" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="gridAsignaciones" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>