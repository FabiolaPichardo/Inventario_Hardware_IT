<Window x:Class="Inventario_Hardware_IT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Inventario IT - Menú Principal" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2D3E50">
            <StackPanel Margin="10">
                <TextBlock Text="INVENTARIO IT" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20,0,30" HorizontalAlignment="Center"/>

                <Button x:Name="btnHardware" Content="💻 Gestión de Hardware" Click="BtnHardware_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button x:Name="btnModelos" Content="📝 Modelos" Click="BtnModelos_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button x:Name="btnMarcas" Content="🏷️ Marcas" Click="BtnMarcas_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button x:Name="btnTipos" Content="🖱️ Tipos de Equipo" Click="BtnTipos_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button Content="👥 Empleados" Click="BtnEmpleados_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button Content="📋 Asignaciones" Click="BtnAsignaciones_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button Content="🛠️ Mantenimiento" Click="BtnManto_Click" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14"/>
                
                <Separator Background="Gray" Margin="0,20"/>

                <Button Content="🚪 Salir" Click="BtnSalir_Click" Height="40" Background="#C0392B" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#ECF0F1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Bienvenido al Sistema" FontSize="30" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Selecciona una opción del menú para comenzar." FontSize="16" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>