<Window x:Class="Inventario_Hardware_IT.GestionEmpleados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Directorio de Empleados" Height="450" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="👤 Catálogo de Empleados" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Nombre Completo:"/>
                <TextBox x:Name="txtNombre" Width="200" Height="25"/>
            </StackPanel>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="No. Empleado (ID):"/>
                <TextBox x:Name="txtNumero" Width="100" Height="25"/>
            </StackPanel>

            <Button Content="Guardar" Click="BtnGuardar_Click" Width="100" Height="25" VerticalAlignment="Bottom" Background="#007ACC" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="gridEmpleados" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F0F0F0"/>
    </Grid>
</Window>