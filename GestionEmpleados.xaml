<Window x:Class="Inventario_Hardware_IT.GestionEmpleados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Directorio de Empleados" Height="600" Width="850" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="BtnAzul" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRojo" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGris" TargetType="Button">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#7F8C8D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F5F7FA" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#B0B0B0" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10,10,0,0" MouseDown="Border_MouseDown" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="DIRECTORIO DE EMPLEADOS" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCerrar_Click" HorizontalAlignment="Right" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" Foreground="#95A5A6" BorderThickness="0" FontSize="16" Cursor="Hand" Style="{x:Null}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="20" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="lblTitulo" Text="Registrar Nuevo Colaborador" Foreground="#007ACC" FontWeight="Bold" FontSize="14"/>
                        <Button Content="Limpiar / Nuevo" Click="BtnLimpiar_Click" HorizontalAlignment="Right" Width="100" Height="25" Style="{StaticResource BtnGris}" FontSize="11"/>
                    </Grid>

                    <Separator Margin="0,10,0,15" Background="#F0F0F0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre Completo:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNombre"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="No. Empleado (ID):" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNumero"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="btnEliminar" Content="ELIMINAR" Click="BtnEliminar_Click" Style="{StaticResource BtnRojo}" Width="100" Height="35" Margin="0,0,10,0" Visibility="Collapsed"/>
                            <Button Content="GUARDAR" Click="BtnGuardar_Click" Style="{StaticResource BtnAzul}" Width="120" Height="35"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="20,0,20,20" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Doble clic en un empleado para editarlo" FontSize="11" Foreground="#95A5A6" Margin="0,0,0,5" HorizontalAlignment="Right" FontStyle="Italic"/>

                    <DataGrid x:Name="gridEmpleados" AutoGenerateColumns="True" IsReadOnly="True" MouseDoubleClick="GridEmpleados_MouseDoubleClick"
                              HeadersVisibility="Column" Background="White" RowBackground="White" AlternatingRowBackground="#F8F9F9"
                              BorderThickness="1" BorderBrush="#ECF0F1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1" Height="250">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#ECF0F1"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>