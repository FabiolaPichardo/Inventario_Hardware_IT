<Window x:Class="Inventario_Hardware_IT.GestionMantenimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Mantenimiento" Height="650" Width="1000" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="BtnNaranja" TargetType="Button">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#D35400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAzulSuave" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F5F7FA" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#B0B0B0" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10,10,0,0" MouseDown="Border_MouseDown" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🛠️" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="CONTROL DE MANTENIMIENTO" Foreground="#2C3E50" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCerrar_Click" HorizontalAlignment="Right" Margin="0,0,15,0"
                            Width="30" Height="30" Background="Transparent" Foreground="#95A5A6" BorderThickness="0" FontSize="16" Cursor="Hand" Style="{x:Null}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                    </Border.Effect>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Registrar Reparación" Foreground="#E67E22" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Text="Equipo a Reparar:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbEquipo" Margin="0,0,0,10"/>

                            <TextBlock Text="Proveedor / Técnico:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbProveedor" Margin="0,0,0,10" DisplayMemberPath="NombreProveedor" SelectedValuePath="ProveedorID"/>

                            <TextBlock Text="Descripción del Problema:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtProblema" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="5" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fecha Entrada:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpFecha" Height="30"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Costo ($):" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtCosto"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="ENVIAR A TALLER" Click="BtnGuardar_Click" Style="{StaticResource BtnNaranja}" Height="40" Margin="0,10,0,20"/>

                            <Border BorderThickness="0,1,0,0" BorderBrush="#ECF0F1" Padding="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="¿Nuevo Proveedor?" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNuevoProv" Grid.Column="0" ToolTip="Escribe el nombre de la empresa" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="Agregar" Click="BtnAddProv_Click" Style="{StaticResource BtnAzulSuave}" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#D0D3D4" Opacity="0.3"/>
                    </Border.Effect>

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Historial de Reparaciones" Foreground="#2C3E50" FontWeight="Bold" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="gridMto" AutoGenerateColumns="True" IsReadOnly="True"
                                  HeadersVisibility="Column" Background="White" RowBackground="White" AlternatingRowBackground="#F8F9F9"
                                  BorderThickness="1" BorderBrush="#ECF0F1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECF0F1"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>