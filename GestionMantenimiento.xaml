<Window x:Class="Inventario_Hardware_IT.GestionMantenimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Mantenimiento (Módulo 4 - Ian)" Height="550" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🛠️ Control de Mantenimiento y Reparaciones" Grid.ColumnSpan="2" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Grid.Column="0" Header="Registrar Reparación" Margin="0,0,10,0" Padding="10">
            <StackPanel>
                <TextBlock Text="Equipo a Reparar:"/>
                <ComboBox x:Name="cbEquipo" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Proveedor (Técnico):"/>
                <ComboBox x:Name="cbProveedor" Height="25" Margin="0,5,0,10" DisplayMemberPath="NombreProveedor" SelectedValuePath="ProveedorID"/>

                <TextBlock Text="Descripción del Problema:"/>
                <TextBox x:Name="txtProblema" Height="60" TextWrapping="Wrap" Margin="0,5,0,10"/>

                <TextBlock Text="Fecha de Entrada:"/>
                <DatePicker x:Name="dpFecha" Margin="0,5,0,10"/>

                <TextBlock Text="Costo ($):"/>
                <TextBox x:Name="txtCosto" Height="25" Margin="0,5,0,20"/>

                <Button Content="Enviar a Mantenimiento" Click="BtnGuardar_Click" Height="35" Background="#E67E22" Foreground="White" FontWeight="Bold"/>

                <TextBlock Text="¿Nuevo Proveedor?" Margin="0,20,0,5" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtNuevoProv" Width="150" Height="25"/>
                    <Button Content="Agreg." Click="BtnAddProv_Click" Width="50" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.Column="1" Header="Historial de Reparaciones" Margin="10,0,0,0" Padding="5">
            <DataGrid x:Name="gridMto" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F0F0F0"/>
        </GroupBox>
    </Grid>
</Window>