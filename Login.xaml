<Window x:Class="Inventario_Hardware_IT.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso al Sistema" Height="500" Width="380" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style x:Key="BtnPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundario" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="White" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="3" Color="#B0B0B0" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="✕" Click="BtnSalir_Click" HorizontalAlignment="Right" Margin="0,10,10,0"
                    Width="30" Height="30" Background="Transparent" Foreground="#BDC3C7" 
                    BorderThickness="0" FontSize="14" Cursor="Hand" Style="{x:Null}"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="35,0,35,10">

                <Border Width="70" Height="70" CornerRadius="35" Background="#F0F4F8" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🏢" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Bienvenido" Foreground="#2C3E50" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Inventario IT" Foreground="#7F8C8D" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <TextBlock Text="Usuario" Foreground="#34495E" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,5"/>
                <Border CornerRadius="6" Background="#F4F6F7" Height="35" Margin="0,0,0,15">
                    <TextBox x:Name="txtUser" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" 
                             Padding="10,0" FontSize="13" Foreground="#2C3E50"/>
                </Border>

                <TextBlock Text="Contraseña" Foreground="#34495E" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,5"/>
                <Border CornerRadius="6" Background="#F4F6F7" Height="35" Margin="0,0,0,25">
                    <PasswordBox x:Name="txtPass" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" 
                                 Padding="10,0" FontSize="13" Foreground="#2C3E50"/>
                </Border>

                <Button Content="INICIAR SESIÓN" Click="BtnEntrar_Click" Style="{StaticResource BtnPrincipal}" Height="40" Margin="0,0,0,15" IsDefault="True"/>
                <Button Content="Salir de la aplicación" Click="BtnSalir_Click" Style="{StaticResource BtnSecundario}" Height="30" VerticalAlignment="Bottom"/>

            </StackPanel>

            <Border Grid.Row="0" Height="40" Background="Transparent" MouseDown="Border_MouseDown" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</Window>