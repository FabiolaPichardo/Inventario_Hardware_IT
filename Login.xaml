<Window x:Class="Inventario_Hardware_IT.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso al Sistema" Height="350" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">
    <Border Background="#2C3E50" CornerRadius="10" Margin="10">
        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔐 INICIO DE SESIÓN" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Usuario:" Foreground="LightGray"/>
                <TextBox x:Name="txtUser" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Contraseña:" Foreground="LightGray"/>
                <PasswordBox x:Name="txtPass" Height="30" Margin="0,5,0,20" VerticalContentAlignment="Center"/>

                <Button Content="ENTRAR" Click="BtnEntrar_Click" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Salir" Click="BtnSalir_Click" Height="30" Background="#C0392B" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>