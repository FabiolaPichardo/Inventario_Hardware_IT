<Window x:Class="Inventario_Hardware_IT.GestionHardware"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Hardware (Inventario)" Height="550" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registro de Equipos (Módulo 1 - Fabian)" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <GroupBox Header="Datos del Equipo" Grid.Row="1" Margin="0,0,0,20" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Modelo del Equipo:"/>
                    <ComboBox x:Name="cbModelo" DisplayMemberPath="NombreModelo" SelectedValuePath="ModeloID"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                    <TextBlock Text="Número de Serie:"/>
                    <TextBox x:Name="txtSerie"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="Etiqueta (Inventario):"/>
                    <TextBox x:Name="txtEtiqueta"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,10,0">
                    <TextBlock Text="Estado (Ej: Disponible):"/>
                    <ComboBox x:Name="cbEstado">
                        <ComboBoxItem Content="Disponible" IsSelected="True"/>
                        <ComboBoxItem Content="Asignado"/>
                        <ComboBoxItem Content="En Reparación"/>
                        <ComboBoxItem Content="Baja"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Fecha de Compra:"/>
                    <DatePicker x:Name="dpFecha"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="btnEliminar" Content="🗑️ Eliminar" Click="BtnEliminar_Click" 
                            Width="80" Height="30" Margin="0,0,10,0" Background="#C0392B" Foreground="White" Visibility="Collapsed"/>

                    <Button x:Name="btnGuardar" Content="💾 Guardar" Click="BtnGuardar_Click" 
                            Width="100" Height="30" Background="#007ACC" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="gridDatos" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F0F0F0"/>
    </Grid>
</Window>